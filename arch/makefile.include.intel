# makefile.include.intel -- Intel Fortran compiler (ifort / ifx)
#
# Copy or symlink to makefile.include before building:
#   cp makefile.include.intel makefile.include
#   make -j$(nproc)

# Compilers
_IFORT := $(shell command -v ifort 2>/dev/null)
_IFX   := $(shell command -v ifx 2>/dev/null)
ifneq ($(_IFORT),)
  FC = ifort
  $(info [compiler] Auto-detected Intel Classic Fortran (ifort))
else ifneq ($(_IFX),)
  FC = ifx
  $(info [compiler] Auto-detected Intel LLVM Fortran (ifx))
else
  $(error "Neither ifort nor ifx found. Please load the Intel oneAPI environment first!")
endif

CC = gcc

# SIMD instruction set
# SIMD instruction set optimization
# Usage: make TYPE=generic (default) or make TYPE=native
TYPE ?= generic

ifeq ($(TYPE),generic)
  SIMD = -msse3
  ifeq ($(MAKELEVEL),0)
    $(info [SIMD] Using generic SSE3 instructions (high compatibility))
  endif
else ifeq ($(TYPE),native)
  SIMD = -xHOST
  ifeq ($(MAKELEVEL),0)
    $(info [SIMD] Using native instructions (optimized for current CPU))
  endif
else
  $(error Unknown TYPE=$(TYPE). Supported values: generic, native)
endif

# Suppress Intel-specific diagnostics
DISDIAG = -diag-disable 8290,8291,6371,10316,6178,6916,7416,5268,7342,7373,5120,5144,5082,5112,2554,5183,6182,7352

# Include search paths (Makefile will append LIBRETAPATH)
INCLUDE = -I./ -I./ext

# Compilation flags
#   -fpp              : enable C preprocessor
#   -fpscomp logicals : Intel logical-value compatibility mode
#   -mkl              : auto-link Intel MKL
#   -static-intel     : statically link Intel runtime
#   -qopenmp-link=static : statically link OpenMP runtime
#   -stand f08        : warn on non-F2008 constructs
COMMON = $(SIMD) $(DISDIAG) -fpscomp logicals -fpp \
         -mkl -static-intel -DINTEL_MKL -stand f08

OPT  = -O2 -qopenmp -qopenmp-link=static -threads -qopt-matmul $(COMMON)
OPT1 = -O1 -qopenmp -qopenmp-link=static -threads $(COMMON)

# Debug build (uncomment to replace the two lines above)
#OPT  = -O0 -qopenmp -qopenmp-link=static -threads $(COMMON) \
#       -debug all -g -traceback -check all -fstack-protector
#OPT1 = $(OPT)

# Extra flags for .F fixed-form files (ifort auto-detects, nothing needed)
FFLAGS_FIXED =

# Warning suppression for third-party code (libreta, dislin stubs, etc.)
FFLAGS_NOWARN       = -diag-disable 6843
FFLAGS_DISLIN_EMPTY = -diag-disable 6178,6843

# Extra flags for xlib.f90
FFLAGS_XLIB = -fpscomp logicals

# blockhrr_012345.f90 is a huge file; compile at -O1 to save time/memory
BLOCKHRR_OPT = -O1 -diag-disable 6843 $(SIMD)

# Link flags (ifort handles static linking via -static-intel and -mkl)
LDFLAGS = $(OPT)

# Libraries
LIB_base  =
LIB_GUI   = $(LIB_base) ./dislin_d-11.0.a -lXm -lXt -lX11 -lGL
LIB_noGUI = $(LIB_base)
